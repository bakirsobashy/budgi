{
  "expo": {
    "name": "Budgi",
    "slug": "finance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icons/main.png",
    "scheme": "Budgi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sobashy.Budgi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/Icons/main.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.sobashy.Budgi"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Icons/main.png",
          "imageWidth": 76,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "./plugins/withMaterialSymbols"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0879a5e0-0382-4d21-bb75-87e1c5f1edf6"
      }
    },
    "owner": "bakirsobashy"
  }
}
